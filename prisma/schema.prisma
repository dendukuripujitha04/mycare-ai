datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum DoctorStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  UPCOMING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum CallStatus {
  PENDING
  INITIATED
  RINGING
  ANSWERED
  COMPLETED
  FAILED
}

model User {
  id              String            @id @default(cuid())
  name            String
  email           String            @unique
  phone           String
  passwordHash    String
  role            Role              @default(USER)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  appointments    Appointment[]
  symptomAnalyses SymptomAnalysis[]
  voiceCalls      VoiceCall[]

  @@index([email])
  @@index([phone])
}

model Doctor {
  id             String          @id @default(cuid())
  name           String
  specialization String
  experience     String
  qualification  String
  phone          String
  email          String
  clinicName     String
  clinicAddress  String
  availableDays  String
  availableFrom  String
  availableTo    String
  imageUrl       String?
  status         DoctorStatus    @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  appointments   Appointment[]

  @@index([specialization])
  @@index([status])
}

model Appointment {
  id                String            @id @default(cuid())
  appointmentNumber String            @unique
  userId            String?
  doctorId          String
  patientName       String            @default("Guest")
  patientPhone      String            @default("")
  appointmentDate   String
  appointmentTime   String
  reason            String
  notes             String?
  status            AppointmentStatus @default(UPCOMING)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  doctor     Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  voiceCalls VoiceCall[]

  @@index([userId])
  @@index([doctorId])
  @@index([appointmentDate])
  @@index([status])
}

model SymptomAnalysis {
  id                  String   @id @default(cuid())
  userId              String?
  symptoms            String
  age                 Int
  gender              String
  duration            String
  severity            String
  possibleConditions  String
  suggestedDoctor     String
  precautions         String
  medicineInformation String
  dos                 String
  donts               String
  emergencyWarning    String?
  createdAt           DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model VoiceCall {
  id            String     @id @default(cuid())
  appointmentId String
  userId        String?
  phoneNumber   String
  agentId       String?
  callId        String?
  status        CallStatus @default(PENDING)
  language      String     @default("en")
  startedAt     DateTime?
  completedAt   DateTime?
  failureReason String?
  createdAt     DateTime   @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([userId])
  @@index([phoneNumber])
  @@index([status])
  @@index([createdAt])
}
